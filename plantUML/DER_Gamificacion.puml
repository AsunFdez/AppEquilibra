@startuml AppEquilibra_ERD

!define TABLENAME(x) class x << (T, #FFCCCC) >>
!define PRIMARY_KEY(x) <b>PK:</b> x
!define FOREIGN_KEY(x) <b>FK:</b> x

title Diagrama Entidad-Relación - AppEquilibra- TABLAS DE GAMIFICACIÓN
' Configuración de los diagramas
'skinparam backgroundColor #FEFEFE
'skinparam ClassBorderColor #000000

' ============================================================
' TABLAS DE GAMIFICACIÓN
' ============================================================
TABLENAME(UserProfile) {
}

TABLENAME(Achievement) {
    <b>PK: id</b> : INTEGER (autogenerado)
    --
    <b>FK: userId</b> : INTEGER
    title : TEXT
    description : TEXT
    points : INTEGER
    key : TEXT
    unlocked : INTEGER (boolean)
    unlockedAt : INTEGER
    categoryColor : INTEGER
    iconRes : INTEGER
}

TABLENAME(UserXP) {
    <b>PK: id</b> : INTEGER (autogenerado)
    --
    <b>FK: userId</b> : INTEGER
    totalXP : INTEGER
    currentLevel : INTEGER
    xpForNextLevel : INTEGER
    achievementsUnlocked : INTEGER
    lastXPEarnedAt : INTEGER
}

TABLENAME(Streak) {
    <b>PK: id</b> : INTEGER (autogenerado)
    --
    <b>FK: userId</b> : INTEGER
    consecutiveDays : INTEGER
    type : TEXT
    startDate : TEXT (yyyy-MM-dd)
    lastActivityDate : TEXT (yyyy-MM-dd)
    maxStreakRecord : INTEGER
    isActive : INTEGER (boolean)
}

UserProfile "1" -- "0..*" UserXP : userId
UserProfile "1" -- "0..*" Streak : userId
UserProfile "1" -- "0..*" Achievement : userId

note bottom of Achievement
  Logros que el usuario tiene que desbloquear
  Se definen en el primer inicio de la app y se desbloquean
  al cumplir ciertos criterios.
  Otorgan experiencia
end note

note bottom of UserXP
  Seguimiento de progreso gamificado
  Experiencia y nivel actual del usuario
end note

note bottom of Streak
  Contabilidad de días de uso consecutivos (rachas)
  Para fomentar el hábito
  Se definen dos: registro de gastos
  y cumplimiento de presupuesto
end note
