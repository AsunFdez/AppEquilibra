@startuml AppEquilibra_ERD

!define TABLENAME(x) class x << (T, #FFCCCC) >>
!define PRIMARY_KEY(x) <b>PK:</b> x
!define FOREIGN_KEY(x) <b>FK:</b> x

title Diagrama Entidad-Relación - AppEquilibra - Tablas Perfil de Usuario

' ============================================================
' TABLAS DE USUARIO Y PERFIL
' ============================================================

TABLENAME(UserProfile) {
    <b>PK: id</b> : INTEGER (fijo: 1)
    --
    name : TEXT
    email : TEXT
    photoUrl : TEXT
    phone : TEXT
    passwordHash : TEXT
    emotionalState : TEXT (JSON)
    mainConcernId : TEXT
    mainConcern : TEXT
    timeAvailable : TEXT
    monthlyIncome : REAL (nullable)
    incomeDay : INTEGER (nullable)
    financialKnowledge : INTEGER
    budgetExperience : INTEGER
    savingsHabit : INTEGER
    createdAt : INTEGER
    updatedAt : INTEGER
    dayCount : INTEGER
    weekProgress : INTEGER
    weekGoal : INTEGER
    weekCount : INTEGER
    lastResetTimestamp : INTEGER
    lastConnectionTimestamp : INTEGER
    xp : INTEGER
}

TABLENAME(SavingGoal) {
    <b>PK: id</b> : INTEGER (autogenerado)
    --
    userId : INTEGER (relación lógica)
    name : TEXT
    targetAmount : REAL
    currentAmount : REAL
    deadline : TEXT (yyyy-MM-dd)
    createdAt : INTEGER
    updatedAt : INTEGER
    completed : INTEGER (0/1)
    monthlySavingAmount : REAL
    monthsRemaining : INTEGER
}

UserProfile "1" -- "0..*" SavingGoal : userId


note right of UserProfile
  Almacena información del perfil del usuario.

end note

note right of SavingGoal
  Objetivo de ahorro del usuario
  Puede haber varias metas de ahorro 
  pero solo una activa. 
end note