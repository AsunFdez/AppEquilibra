@startuml AppEquilibra_ERD

!define TABLENAME(x) class x << (T, #FFCCCC) >>
!define PRIMARY_KEY(x) <b>PK:</b> x
!define FOREIGN_KEY(x) <b>FK:</b> x

title Diagrama Entidad-Relación - AppEquilibra - TABLAS DE TRANSACCIONES FINANCIERAS
' Configuración de los diagramas
'skinparam backgroundColor #FEFEFE
'skinparam ClassBorderColor #000000


' ============================================================
' TABLAS DE TRANSACCIONES FINANCIERAS
' ============================================================

TABLENAME(UserProfile) {
}

TABLENAME(ExpenseCategory) {
    <b>PK: id</b> : INTEGER (autogenerado)
    --
    name : TEXT (UNIQUE)
    iconResId : INTEGER
    iconName : TEXT
    color : TEXT
    isSelected : INTEGER (boolean)
}

TABLENAME(Expense) {
    <b>PK: id</b> : INTEGER (autogenerado)
    --
    <b>FK: userId</b> : INTEGER
    type : TEXT (expense/income)
    amount : REAL
    <b>FK: category</b> : INTEGER (nullable, id de ExpenseCategory)
    description : TEXT
    date : TEXT (dd/MM/yyyy)
    time : TEXT
    timestamp : INTEGER
    isRecurring : INTEGER (boolean)
    patternCount : INTEGER
    notes : TEXT
}

TABLENAME(Budget) {
    <b>PK: id</b> : INTEGER (autogenerado)
    --
    <b>FK: userId</b> : INTEGER
    monthlyBudget : REAL
    weeklyBudget : REAL
    dailyBudget : REAL
    currency : TEXT
    enabled : INTEGER (boolean)
    createdAt : INTEGER
    updatedAt : INTEGER
}

ExpenseCategory "0..1" -- "0..*" Expense : category
UserProfile "1" -- "0..*" Expense : userId
UserProfile "1" -- "0..*" Budget : userId


note bottom of Expense
  Registro de gastos e ingresos.
  La categoría es opcional para ingresos; eliminar una categoría
  conserva la transacción y deja category a null.
  Cada transacción pertenece a un perfil de usuario.
end note

note bottom of Budget
  Límites globales diario, semanal y mensual,
  con moneda y estado de activación.
  Cada presupuesto pertenece a un perfil de usuario.
end note

note bottom of ExpenseCategory
  name tiene índice único.
end note