<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient de fondo: De azul oscuro a violeta con toque de oro -->
    <gradient
        android:angle="135"
        android:endColor="#7C3AED"
        android:startColor="#2563EB"
        android:type="linear" />

    <!-- Esquinas redondeadas -->
    <corners android:radius="24dp" />

    <!-- Borde para mayor definición -->
    <stroke
        android:width="2dp"
        android:color="#A78BFA" />

    <!-- Padding interno -->
    <padding
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp" />
</shape>
