<?xml version="1.0" encoding="utf-8"?>
<!--
    Progress drawable para mostrar el progreso hacia el siguiente nivel
    Usa colores principales de la app
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background track (gris claro) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/gray_300" />
        </shape>
    </item>

    <!-- Progress (degradado azul -> púrpura) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient
                    android:angle="90"
                    android:endColor="@color/accent_light"
                    android:startColor="@color/primary"
                    android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
