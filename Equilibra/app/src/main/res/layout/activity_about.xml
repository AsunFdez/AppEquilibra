<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para AboutActivity
    Pantalla "Acerca de"
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light"
        tools:context=".activities.AboutActivity">

        <!-- App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/about"
                app:titleTextColor="@android:color/white"
                app:navigationIcon="@drawable/ic_arrow_back" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Contenido principal -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Card: Logo y versión -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <!-- Logo -->
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/ic_launcher_foreground"
                            android:contentDescription="@string/app_logo" />

                        <!-- Nombre de la app -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_marginTop="14dp" />

                        <!-- Versión -->
                        <TextView
                            android:id="@+id/tvVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="8dp"
                            tools:text="Versión 1.0.0 (1)" />

                        <!-- Descripción -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_description"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:textAlignment="center"
                            android:layout_marginTop="14dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Sección: Enlaces -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_links"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="8dp" />

                <!-- Card: Licencias -->
                <asunfdiez.com.equilibra.views.FeatureCard
                    android:id="@+id/cardLicenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/secondary_lighter"
                    app:cardIconCircle="@drawable/circle_background_white"
                    app:cardIcon="@drawable/ic_code"
                    app:cardIconTint="@color/secondary"
                    app:cardTitle="@string/open_source_licenses"
                    app:showRightIcon="true"
                    app:cardRightIconTint="@color/secondary"/>

                <!-- Sección: Contacto -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_contact"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="16dp" />

                <!-- Card: Soporte -->
                <asunfdiez.com.equilibra.views.FeatureCard
                    android:id="@+id/cardSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_accent_light"
                    app:cardIconCircle="@drawable/circle_background_white"
                    app:cardIcon="@drawable/ic_email"
                    app:cardIconTint="@color/accent"
                    app:cardTitle="@string/support"
                    app:cardRightIcon="@drawable/ic_open_in_new"
                    app:cardRightIconTint="@color/accent"
                    app:showRightIcon="true" />

                <!-- Card: GitHub -->
                <asunfdiez.com.equilibra.views.FeatureCard
                android:id="@+id/cardGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/background_accent_light"
                app:cardIconCircle="@drawable/circle_background_white"
                app:cardIcon="@drawable/ic_github"
                app:cardIconTint="@color/accent"
                app:cardTitle="@string/github"
                app:cardRightIcon="@drawable/ic_open_in_new"
                app:cardRightIconTint="@color/accent"
                app:showRightIcon="true" />

                <!-- Botones de acción -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Equilibra.Button.Secondary"
                        android:id="@+id/btnShareApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:text="@string/share_app"
                        app:icon="@drawable/ic_share"
                        app:iconTint="@android:color/white"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Equilibra.Button.Primary"
                        android:id="@+id/btnRateApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:text="@string/rate_app"
                        app:icon="@drawable/ic_ach_star"
                        app:iconTint="@android:color/white"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>