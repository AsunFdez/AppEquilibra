<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipChildren= "false">

    <!-- Header Section -->
    <include
        android:id="@+id/headerSection"
        layout="@layout/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Progress Card -->
            <include
                android:id="@+id/progressCard"
                layout="@layout/progress_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <!-- Daily Tip Card -->
            <asunfdiez.com.equilibra.views.FeatureCard
                android:id="@+id/tipCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor ="@color/tip_card_bg"
                app:cardIconCircle="@drawable/circle_primary"
                app:cardIcon="@drawable/ic_fea_lightbulb"
                app:cardTitle="@string/today_advice"
                app:cardDescription="@string/advice_1"
                app:showArrow="false"
                app:showRightIcon="false"
                />

            <!-- Quick Action Card -->
            <include
                android:id="@+id/quickActionCard"
                layout="@layout/quick_action_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>


            <!-- Next Goal Card -->
            <asunfdiez.com.equilibra.views.FeatureCard
                android:id="@+id/nextGoalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"

                app:cardIconCircle="@drawable/circle_secondary_light"
                app:cardIcon="@drawable/ic_fea_flag"
                app:cardIconTint = "@color/equilibra_secondary"
                app:cardTitle="@string/next_goal_title"
                app:cardDescription="@string/next_goal_1"
                app:showArrow="false"
                app:showRightIcon="false"
                />

            <!-- Ver Todos los Gastos Card -->
            <asunfdiez.com.equilibra.views.FeatureCard
                android:id="@+id/viewAllExpensesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor ="@color/expenses_card_bg"
                app:cardIcon="@drawable/ic_fea_receipt_euro"
                app:cardIconCircle="@drawable/circle_accent"
                app:cardTitle="@string/my_expenses_tile"
                app:cardDescription="@string/my_expenses_text"
                app:showArrow="true"
                app:showRightIcon="false"
                />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
