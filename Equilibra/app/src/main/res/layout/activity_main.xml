<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para la pantalla principal
    Usuario principiante

-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="user"
            type="asunfdiez.com.equilibra.models.UserProfile" />

        <variable
            name="viewModel"
            type="asunfdiez.com.equilibra.viewmodels.MainViewModel" />

        <variable
            name="adviceViewModel"
            type="asunfdiez.com.equilibra.viewmodels.AdviceViewModel" />

        <variable
            name="gamificationViewModel"
            type="asunfdiez.com.equilibra.viewmodels.GamificationViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light"
        android:clipChildren="false">

        <!-- Header Section -->
        <include
            android:id="@+id/headerSection"
            layout="@layout/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:user="@{user}" />

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerSection">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/beginnerUser"
                    layout="@layout/beginner_user"
                    android:visibility="@{viewModel.currentView.equals(&quot;beginner&quot;) ? View.VISIBLE : View.GONE}"
                    app:user="@{user}"
                    app:adviceViewModel="@{adviceViewModel}"
                    app:gamificationViewModel="@{gamificationViewModel}" />

                <include
                    android:id="@+id/intermediateUser"
                    layout="@layout/intermediate_user"
                    android:visibility="@{viewModel.currentView.equals(&quot;intermediate&quot;) ? View.VISIBLE : View.GONE}"
                    app:viewModel="@{viewModel}"
                    app:gamificationViewModel="@{gamificationViewModel}" />

                <include
                    android:id="@+id/advancedUser"
                    layout="@layout/advanced_user"
                    android:visibility="@{viewModel.currentView.equals(&quot;advanced&quot;) ? View.VISIBLE : View.GONE}"
                    app:viewModel="@{viewModel}"
                    app:gamificationViewModel="@{gamificationViewModel}" />

                <!-- Ver Todos los Gastos Card -->
                <asunfdiez.com.equilibra.views.FeatureCard
                    android:id="@+id/viewAllExpensesCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/background_accent_light"
                    app:cardIcon="@drawable/ic_fea_receipt_euro"
                    app:cardIconCircle="@drawable/circle_accent"
                    app:cardTitle="@string/my_expenses_tile"
                    app:cardDescription="@string/my_expenses_text"
                    app:cardRightIconTint="@color/accent"
                    app:showRightIcon="true" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation -->
        <include
            android:id="@+id/bottomNav"
            layout="@layout/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
