<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para Intervención Suave
    Pantalla que se muestra cuando los gastos son altos
    Ofrece consejos y sugerencias de forma amigable
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_primary">

        <!-- AppBar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_close"
                app:title=""
                app:titleTextColor="@color/text_primary" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Contenido principal -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Animación/Ilustración principal -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="24dp">

                    <!-- Círculo de fondo -->
                    <ImageView
                        android:id="@+id/ivBackgroundCircle"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_gravity="center"
                        android:src="@drawable/circle_background_accent"
                        android:alpha="0.2" />

                    <!-- Icono principal -->
                    <ImageView
                        android:id="@+id/ivInterventionIcon"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_alert_soft"
                        android:tint="@color/equilibra_accent" />

                </FrameLayout>

                <!-- Título principal -->
                <TextView
                    android:id="@+id/tvInterventionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¡Momento de reflexión!"
                    android:textSize="28sp"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Subtítulo -->
                <TextView
                    android:id="@+id/tvInterventionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tus gastos están un poco altos este mes"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginBottom="32dp" />

                <!-- Card de estadística principal -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/accent_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Has gastado"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.9"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvExpenseAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.500.00 €"
                            android:textSize="40sp"
                            android:textColor="@android:color/white"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvExpensePercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75% de tu presupuesto mensual"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.9" />

                        <!-- Barra de progreso -->
                        <ProgressBar
                            android:id="@+id/progressExpense"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="16dp"
                            android:max="100"
                            android:progress="75"
                            android:progressDrawable="@drawable/progress_bar_intervention" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Mensaje motivacional -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_fea_lightbulb"
                            android:tint="@color/equilibra_accent"
                            android:layout_marginEnd="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Consejo del día"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvMotivationalMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pequeños cambios pueden hacer una gran diferencia en tus finanzas"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Título de sugerencias -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Te sugerimos:"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <!-- Sugerencia 1 -->
                <LinearLayout
                    android:id="@+id/layoutSuggestion1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_suggestion_card"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_check_circle"
                        android:tint="@color/equilibra_primary"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSuggestion1Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Revisa tus gastos en entretenimiento"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSuggestion1Description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Has gastado 300€ más que el mes pasado"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_chevron_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Sugerencia 2 -->
                <LinearLayout
                    android:id="@+id/layoutSuggestion2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_suggestion_card"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_check_circle"
                        android:tint="@color/equilibra_primary"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSuggestion2Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reduce gastos en restaurantes"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSuggestion2Description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cocinar en casa podría ahorrarte 200€/mes"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_chevron_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Sugerencia 3 -->
                <LinearLayout
                    android:id="@+id/layoutSuggestion3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_suggestion_card"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_check_circle"
                        android:tint="@color/equilibra_primary"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSuggestion3Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Establece un límite diario"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSuggestion3Description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Te ayudará a cumplir tu presupuesto"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_chevron_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Botones de acción -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <!-- Botón principal -->
                    <Button
                        android:id="@+id/btnViewDetails"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Ver análisis detallado"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:background="@drawable/button_primary"
                        android:elevation="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Botón secundario -->
                    <Button
                        android:id="@+id/btnAdjustBudget"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Ajustar mi presupuesto"
                        android:textColor="@color/equilibra_primary"
                        android:textSize="16sp"
                        android:background="@drawable/button_outline_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- Botón terciario -->
                    <Button
                        android:id="@+id/btnDismiss"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Entendido, continuar"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:background="@android:color/transparent" />

                </LinearLayout>

                <!-- Mensaje de apoyo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estamos aquí para ayudarte a alcanzar tus metas 💪"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>