<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="asunfdiez.com.equilibra.viewmodels.MainViewModel" />

        <variable
            name="gamificationViewModel"
            type="asunfdiez.com.equilibra.viewmodels.GamificationViewModel" />
    </data>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Resumen Financiero -->
                <include
                    layout="@layout/component_advanced_summary"
                    android:id="@+id/advancedSummary" />

                <!-- Insight/Alerta -->
                <include
                    layout="@layout/insight_card"
                    android:id="@+id/insightCard" />

                <!-- Rachas Activas -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_streaks"
                            android:textColor="@color/gray_800"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <!-- Racha 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">
                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/circle_accent"
                                android:alpha="0.1"
                                android:layout_marginEnd="12dp"/>
                            <!-- Reusing icon with actual color on top -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_fea_lightbulb"
                                app:tint="@color/accent"
                                android:layout_marginStart="-42dp"
                                android:layout_marginEnd="24dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text='@{@string/streak_days_recording(45)}'
                                android:textColor="@color/gray_700"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Racha 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/circle_primary"
                                android:alpha="0.1"
                                android:layout_marginEnd="12dp"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_ach_target"
                                app:tint="@color/secondary"
                                android:layout_marginStart="-42dp"
                                android:layout_marginEnd="24dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text='@{@string/streak_days_budget(12)}'
                                android:textColor="@color/gray_700"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Preview de Logros Gamificación -->
                <include
                    layout="@layout/component_achievements_preview"
                    android:id="@+id/achievementsPreview"
                    app:gamificationViewModel="@{gamificationViewModel}" />

                <!-- Resumen financiero principal -->
                <include
                    layout="@layout/balance_card"
                    android:id="@+id/balanceCard" />

                <!-- Gráfico principal: Flujo de efectivo -->
                <include
                    layout="@layout/chart_card"
                    android:id="@+id/chartCashFlowCard" />

                <!-- Gráfico secundario: Distribución de gastos -->
                <include
                    layout="@layout/chart_card"
                    android:id="@+id/chartExpensesDistributionCard" />

                <!-- Metas y objetivos -->
                <include
                    layout="@layout/goal_card"
                    android:id="@+id/goalCard" />

            </LinearLayout>

</layout>