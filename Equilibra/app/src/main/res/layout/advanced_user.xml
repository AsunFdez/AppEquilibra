<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="asunfdiez.com.equilibra.viewmodels.MainViewModel" />

        <variable
            name="gamificationViewModel"
            type="asunfdiez.com.equilibra.viewmodels.GamificationViewModel" />
    </data>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Resumen Financiero -->
                <include
                    layout="@layout/component_advanced_summary"
                    android:id="@+id/advancedSummary" />

                <!-- Insight/Alerta -->
                <include
                    layout="@layout/insight_card"
                    android:id="@+id/insightCard" />

                <!-- Rachas Activas -->
                <include
                    layout="@layout/component_streaks"
                    android:id="@+id/streaksCard"
                    app:gamificationViewModel="@{gamificationViewModel}" />

                <!-- Preview de Logros Gamificación -->
                <include
                    layout="@layout/component_achievements_preview"
                    android:id="@+id/achievementsPreview"
                    app:gamificationViewModel="@{gamificationViewModel}" />

                <!-- Resumen financiero principal -->
                <include
                    layout="@layout/balance_card"
                    android:id="@+id/balanceCard" />

                <!-- Gráfico principal: Flujo de efectivo -->
                <include
                    layout="@layout/chart_card"
                    android:id="@+id/chartCashFlowCard" />

                <!-- Gráfico secundario: Distribución de gastos -->
                <include
                    layout="@layout/chart_card"
                    android:id="@+id/chartExpensesDistributionCard" />

                <!-- Metas y objetivos -->
                <include
                    layout="@layout/goal_card"
                    android:id="@+id/goalCard" />

            </LinearLayout>

</layout>