<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="asunfdiez.com.equilibra.viewmodels.MainViewModel" />

        <variable
            name="gamificationViewModel"
            type="asunfdiez.com.equilibra.viewmodels.GamificationViewModel" />
    </data>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Resumen Financiero -->
                <include
                    layout="@layout/component_advanced_summary"
                    android:id="@+id/advancedSummary"
                    app:viewModel="@{viewModel}" />

                <!-- Rachas Activas -->
                <include
                    layout="@layout/component_streaks"
                    android:id="@+id/streaksCard"
                    app:gamificationViewModel="@{gamificationViewModel}" />



                <!-- Gráfico principal: BarChart mensual -->
                <include
                    layout="@layout/component_bar_chart"
                    android:id="@+id/chartMonthlyCard"
                    app:title="@{@string/trend_monthly}"
                    app:hasData="@{viewModel.monthlyExpensesChart != null}"
                    app:chartData="@{viewModel.monthlyExpensesChart}"
                    app:labels="@{viewModel.monthlyChartLabels}"
                    app:showValues="@{false}" />

                <!-- Gráfico secundario: PieChart Mensual con Distribución de gastos -->
                <include
                    layout="@layout/component_pie_chart"
                    android:id="@+id/chartExpensesDistributionCard"
                    app:title="@{@string/expenses_by_category}"
                    app:hasData="@{viewModel.topCategoriesAnalysis != null &amp;&amp; !viewModel.topCategoriesAnalysis.isEmpty()}"
                    app:analysisEntries="@{viewModel.topCategoriesAnalysis}"
                    app:showLegend="@{false}" />

                <!-- Metas y objetivos -->
                <include
                    layout="@layout/component_goal_card"
                    android:id="@+id/goalCard"
                    app:viewModel="@{viewModel}" />

            </LinearLayout>

</layout>