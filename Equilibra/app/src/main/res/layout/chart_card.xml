<?xml version="1.0" encoding="utf-8"?>
<!--
    Componente común: Card de gráfico/estadística
    Contenedor para gráficos con título
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardChart"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header con título y acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Título del gráfico"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvChartSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtítulo"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:visibility="visible" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivChartAction"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_chevron_right"
                android:tint="@color/text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Contenedor del gráfico -->
        <FrameLayout
            android:id="@+id/frameChartContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/background_secondary">

            <!-- Placeholder para el gráfico -->
            <TextView
                android:id="@+id/tvChartPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Gráfico"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

        </FrameLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>