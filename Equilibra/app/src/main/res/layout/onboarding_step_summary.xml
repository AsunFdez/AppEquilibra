<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />
        <import type="asunfdiez.com.equilibra.utils.Constants" />
        <variable
            name="user"
            type="asunfdiez.com.equilibra.models.UserProfile" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Icon Container -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/iconBackground"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_gradient_primary" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_onb_circle_check_big"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="@string/plan_ready"
                android:textColor="@color/gray_800"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="@string/saving_plan"
                android:textColor="@color/gray_600"
                android:textSize="16sp" />

            <!-- Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Goal Section (conditional) -->
                    <LinearLayout
                        android:id="@+id/goalSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:visibility="@{user.savingGoal != null ? View.VISIBLE : View.GONE}">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/hint_goal"
                            android:textColor="@color/gray_600"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/goalText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{user.savingGoal}"
                            android:textColor="@color/gray_800"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/gray_200" />
                    </LinearLayout>

                    <!-- Saving Amount Section (conditional) -->
                    <LinearLayout
                        android:id="@+id/savingAmountSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:visibility="@{user.savingAmount != null &amp;&amp; !user.savingAmount.empty ? View.VISIBLE : View.GONE}">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/savings_goal"
                            android:textColor="@color/gray_600"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/savingAmountText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:formattedAmount="@{user.savingAmount}"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/gray_200" />
                    </LinearLayout>

                    <!-- Monthly Saving Section (conditional) -->
                    <LinearLayout
                        android:id="@+id/monthlySavingSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:visibility="@{user.savingAmount != null &amp;&amp; !user.savingAmount.empty ? View.VISIBLE : View.GONE}">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/suggested_savings_monthly"
                            android:textColor="@color/gray_600"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/monthlySavingText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:amount="@{user.savingAmount}"
                            app:divisor="@{Constants.MONTHLY_DIVISION_FACTOR}"
                            android:textColor="@color/secondary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/goal_time"
                            android:textColor="@color/gray_500"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/gray_200" />
                    </LinearLayout>

                    <!-- Emotion Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/emotional_state"
                            android:textColor="@color/gray_600"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/emotionEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{user.emotionalState.emoji()}"
                                android:textSize="28sp" />

                            <TextView
                                android:id="@+id/emotionText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@{user.emotionalState.text()}"
                                android:textColor="@color/gray_800"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Continue Button -->
            <com.google.android.material.button.MaterialButton
                style="@style/Equilibra.Button.Primary"
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_continue" />

        </LinearLayout>
    </ScrollView>
</layout>