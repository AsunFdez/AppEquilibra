<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="asunfdiez.com.equilibra.viewmodels.MainViewModel" />

        <variable
            name="gamificationViewModel"
            type="asunfdiez.com.equilibra.viewmodels.GamificationViewModel" />
    </data>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Balance Card -->
                <include
                    layout="@layout/component_intermediate_balance"
                    android:id="@+id/intermediateBalance"
                    app:viewModel="@{viewModel}" />

                <!-- Presupuesto Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/budgetCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text='@{@string/budget_month(viewModel.currentMonthName)}'
                                android:textColor="@color/gray_800"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text='@{@string/days_left(viewModel.daysRemaining)}'
                                android:textColor="@color/gray_600"
                                android:textSize="12sp" />
                        </RelativeLayout>

                        <ProgressBar
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="@{viewModel.budgetProgress}"
                            android:progressDrawable="@drawable/custom_progress_bar"
                            android:layout_marginBottom="12dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text='@{@string/used_amount_percent(viewModel.budgetProgress)}'
                                android:textColor="@color/gray_600"
                                android:textSize="12sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                app:formattedAmount="@{viewModel.activeBudget.monthlyBudget - viewModel.currentMonthExpenses}"
                                android:textColor="@color/gray_800"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Meta Ahorro (Vacaciones) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:visibility="@{viewModel.activeSavingGoal != null ? android.view.View.VISIBLE : android.view.View.GONE}">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_ana_plane"
                                app:tint="@color/accent"
                                android:layout_marginEnd="12dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{viewModel.activeSavingGoal.name}"
                                android:textColor="@color/gray_800"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="@{viewModel.goalProgress}"
                            android:progressDrawable="@drawable/custom_progress_bar"
                            android:progressTint="@color/accent"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text='@{String.format("%.0f € / %.0f €", viewModel.activeSavingGoal.currentAmount, viewModel.activeSavingGoal.targetAmount)}'
                            android:textColor="@color/gray_800"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <!-- Gráfico de gastos -->
                <include
                    android:id="@+id/includeChartExpenses"
                    layout="@layout/component_bar_chart"
                    app:title="@{@string/weekly_tendency}"
                    app:hasData="@{viewModel.hasWeeklyData}"
                    app:chartData="@{viewModel.weeklyExpensesChart}"
                    app:labels="@{viewModel.weeklyChartLabels}"
                    app:showValues="@{false}" />

                <!-- Metas financieras -->
                <include
                    layout="@layout/component_goal_card"
                    android:id="@+id/goalCard"
                    app:viewModel="@{viewModel}" />


                <!-- Preview de Logros Gamificación -->
                <include
                    layout="@layout/component_achievements_preview"
                    android:id="@+id/achievementsPreview"
                    app:gamificationViewModel="@{gamificationViewModel}" />

            </LinearLayout>

</layout>