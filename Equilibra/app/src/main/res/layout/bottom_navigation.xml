<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Top Border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200" />

    <!-- Navigation Items Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <!-- Navigation Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Home Button -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_nav_home"
                    android:tint="@color/equilibra_primary" />

                <TextView
                    android:id="@+id/navHomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicio"
                    android:textColor="@color/equilibra_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Analysis Button -->
            <LinearLayout
                android:id="@+id/navAnalysis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/navAnalysisIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_nav_trending_up"
                    android:tint="@color/gray_400" />

                <TextView
                    android:id="@+id/navAnalysisText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Análisis"
                    android:textColor="@color/gray_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Spacer for FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Achievements Button -->
            <LinearLayout
                android:id="@+id/navAchievements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/navAchievementsIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_nav_trophy"
                    android:tint="@color/gray_400" />

                <TextView
                    android:id="@+id/navAchievementsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logros"
                    android:textColor="@color/gray_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Settings Button -->
            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_nav_settings"
                    android:tint="@color/gray_400" />

                <TextView
                    android:id="@+id/navSettingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ajustes"
                    android:textColor="@color/gray_400"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- FAB (Floating Action Button) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/fabAddExpense"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="-32dp"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@color/equilibra_primary"
            app:cardCornerRadius="32dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_plus"
                android:tint="@android:color/white" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</LinearLayout>