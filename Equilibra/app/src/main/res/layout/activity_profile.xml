<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para la pantalla de Perfil
    Permite visualizar y editar información del usuario

-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <import type="asunfdiez.com.equilibra.R"/>
        <import type="asunfdiez.com.equilibra.adapters.ProfileBindingAdapter" />
        <variable
            name="viewModel"
            type="asunfdiez.com.equilibra.viewmodels.ProfileViewModel" />
        <variable
            name="user"
            type="asunfdiez.com.equilibra.models.UserProfile" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_primary">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            app:elevation="4dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarProfile"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primary"
                app:titleTextColor="@android:color/white"
                app:navigationIcon="@drawable/ic_arrow_back" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header con imagen de perfil -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_gradient_primary">

                    <ImageView
                        android:id="@+id/ivProfileImage"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_centerInParent="true"
                        app:profileImage="@{user.photoUrl}"
                        android:background="@drawable/circle_background_white"
                        android:padding="4dp"
                        android:elevation="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignEnd="@id/ivProfileImage"
                        android:layout_alignBottom="@id/ivProfileImage"
                        android:src="@drawable/ic_camera"
                        android:background="@drawable/circle_background_accent"
                        android:padding="6dp"
                        android:elevation="6dp"
                        app:tint="@android:color/white" />

                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                    style="@style/Equilibra.Button.Primary"
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.hasProfile ? @string/profile_edition : @string/profile_create}"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white"
                    app:iconPadding="12dp"
                    app:iconSize="24dp"
                    app:rippleColor="@android:color/white"
                    android:visibility="@{viewModel.editMode ? View.GONE : View.VISIBLE}"/>

                <com.google.android.material.button.MaterialButton
                    style="@style/Equilibra.Button.Primary"
                    android:id="@+id/btnGoogleProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_google"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="24dp"
                    app:rippleColor="@android:color/white"
                    app:iconTint="@null"
                    android:visibility="@{viewModel.firebaseAuthenticated ? View.VISIBLE : View.GONE}"/>


                <!-- Información del perfil -->
                <LinearLayout
                    android:id="@+id/layoutProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="@{viewModel.editMode ? View.VISIBLE : (viewModel.hasProfile ? View.VISIBLE : View.GONE)}" >

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{user.name}"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{user.email}"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_gravity="center_horizontal"
                        android:visibility="@{viewModel.hasProfile ? View.VISIBLE : View.GONE}" />


                    <!-- Formulario de edición -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_personal_info"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="12dp"
                        android:paddingStart="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxBackgroundColor="@android:color/white"
                        style="@style/InputField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@={user.name}"
                            android:textColor="@color/text_primary"
                            android:hint="@string/profile_name"
                            android:inputType="textPersonName"
                            android:focusable="@{viewModel.editMode}"
                            android:focusableInTouchMode="@{viewModel.editMode}"
                            android:clickable="@{viewModel.editMode}"
                            android:cursorVisible="@{viewModel.editMode}"
                            style="@style/InputField.EditText"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxBackgroundColor="@android:color/white"
                        style="@style/InputField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@={user.email}"
                            android:textColor="@color/text_primary"
                            android:hint="@string/profile_email"
                            android:inputType="textEmailAddress"
                            android:focusable="@{viewModel.editMode}"
                            android:focusableInTouchMode="@{viewModel.editMode}"
                            android:clickable="@{viewModel.editMode}"
                            android:cursorVisible="@{viewModel.editMode}"
                            style="@style/InputField.EditText"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxBackgroundColor="@android:color/white"
                        app:boxStrokeColor="@color/primary"
                        style="@style/InputField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@={user.phone}"
                            android:textColor="@color/text_primary"
                            android:hint="@string/profile_phone"
                            android:inputType="phone"
                            android:focusable="@{viewModel.editMode}"
                            android:focusableInTouchMode="@{viewModel.editMode}"
                            android:clickable="@{viewModel.editMode}"
                            android:cursorVisible="@{viewModel.editMode}"
                            style="@style/InputField.EditText"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxBackgroundColor="@android:color/white"
                        app:boxStrokeColor="@color/primary"
                        app:suffixText="€"
                        style="@style/InputField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMonthlyIncome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:etMonthlyIncome ="@={user.monthlyIncome}"
                            android:textColor="@color/text_primary"
                            android:hint="@string/profile_monthly_income"
                            android:inputType="numberDecimal"
                            android:focusable="@{viewModel.editMode}"
                            android:focusableInTouchMode="@{viewModel.editMode}"
                            android:clickable="@{viewModel.editMode}"
                            android:cursorVisible="@{viewModel.editMode}"
                            style="@style/InputField.EditText"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxBackgroundColor="@android:color/white"
                        app:boxStrokeColor="@color/primary"
                        style="@style/InputField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIncomeDay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:etIntegerValue ="@={user.incomeDay}"
                            android:textColor="@color/text_primary"
                            android:hint="@string/profile_day_income"
                            android:inputType="number"
                            android:focusable="@{viewModel.editMode}"
                            android:focusableInTouchMode="@{viewModel.editMode}"
                            android:clickable="@{viewModel.editMode}"
                            android:cursorVisible="@{viewModel.editMode}"
                            style="@style/InputField.EditText"/>

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Botón guardar (oculto por defecto) -->
                    <com.google.android.material.button.MaterialButton
                        style="@style/Equilibra.Button.Primary"
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save_changes"
                        android:visibility="@{viewModel.editMode ? View.VISIBLE : View.GONE}" />

                    <!-- Zona de peligro -->
                    <TextView
                        id="@+id/tvDangerZone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_danger_zone"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:layout_marginBottom="12dp"
                        android:paddingStart="4dp"
                        android:visibility="@{viewModel.editMode ? View.GONE : View.VISIBLE}"/>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Equilibra.Button.Accent"
                        android:id="@+id/btnDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_account"
                        android:visibility="@{viewModel.editMode ? View.GONE : View.VISIBLE}"/>




                </LinearLayout>

                <!-- Sección de Firebase Login en Google-->
                <asunfdiez.com.equilibra.views.FeatureCard
                    android:id="@+id/cardGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/primary_lightest"
                    app:cardIconCircle="@drawable/circle_background_white"
                    app:cardIcon='@{viewModel.firebaseAuthenticated ? @drawable/ic_cloud : @drawable/ic_cloud_off }'
                    app:cardIconTint="@color/primary"
                    app:cardTitle='@{viewModel.firebaseAuthenticated ? @string/profile_firebase_connected(viewModel.firebaseEmail) : @string/profile_firebase_disconnected}'
                    app:cardDescription='@{viewModel.firebaseAuthenticated ? null : context.getString(R.string.google_settings_desc)}'
                    app:cardFormattedSyncTime='@{viewModel.firebaseAuthenticated ? viewModel.lastSyncTime : -1L}'
                    app:cardRightIconTint="@color/primary"
                    app:showRightIcon="true"
                    />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>