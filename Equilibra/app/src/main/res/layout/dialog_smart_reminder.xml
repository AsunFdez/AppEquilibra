<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="reminder"
            type="asunfdiez.com.equilibra.models.SmartReminder" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/warningLight">

            <!-- Header con icono -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@color/warning">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_fea_lightbulb"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Recordatorio Inteligente"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Contenido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Mensaje del patrón -->
                <TextView
                    android:id="@+id/tvPatternMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{reminder.patternMessage}"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp"
                    android:textStyle="bold" />

                <!-- Card con sugerencias -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sugerencias:"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Sugerencia 1 -->
                        <LinearLayout
                            android:id="@+id/layoutSuggestion1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_bullet"
                                android:backgroundTint="@color/primary" />

                            <TextView
                                android:id="@+id/tvSuggestion1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/textPrimary"
                                android:textSize="13sp"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                        <!-- Sugerencia 2 -->
                        <LinearLayout
                            android:id="@+id/layoutSuggestion2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_bullet"
                                android:backgroundTint="@color/primary" />

                            <TextView
                                android:id="@+id/tvSuggestion2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/textPrimary"
                                android:textSize="13sp"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btnAdjust"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Ajustar"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:background="?attr/selectableItemBackground"
                        style="@style/Widget.AppCompat.Button.Borderless" />

                    <Button
                        android:id="@+id/btnConfirm"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="Confirmar"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:background="@drawable/bg_button_primary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</layout>