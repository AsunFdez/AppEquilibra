<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para AppearanceSettingsActivity (MVVM + Data Binding)
    Configuración de apariencia y tema
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="asunfdiez.com.equilibra.viewmodels.AppearanceSettingsViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light"
        tools:context=".activities.AppearanceSettingsActivity">

        <!-- App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/secondary">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/appearance_settings"
                app:titleTextColor="@android:color/white"
                app:navigationIcon="@drawable/ic_arrow_back" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Contenido principal -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Selector: Vista -->
                <asunfdiez.com.equilibra.views.SelectorView
                    android:id="@+id/selectorView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardTitle="@string/view_mode"
                    app:cardIcon="@drawable/ic_view_mode"
                    app:selectorLabel="@string/view_selector_text"
                    app:selectorValue='@{viewModel.viewMode.equals("beginner") ? @string/view_selector_text_beginner : (viewModel.viewMode.equals("intermediate") ? @string/view_selector_text_intermediate : @string/view_selector_text_advanced)}' />

                <!-- Selector: Tema -->
                <asunfdiez.com.equilibra.views.SelectorView
                    android:id="@+id/selectorTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardTitle="@string/theme"
                    app:cardIcon="@drawable/ic_palette"
                    app:selectorLabel="@string/theme"
                    app:selectorValue='@{viewModel.theme.equals("light") ? @string/theme_light : (viewModel.theme.equals("dark") ? @string/theme_dark : @string/theme_auto)}' />

                <!-- Selector: Idioma -->
                <asunfdiez.com.equilibra.views.SelectorView
                    android:id="@+id/selectorLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardTitle="@string/language"
                    app:cardIcon="@drawable/ic_language"
                    app:selectorLabel="@string/language"
                    app:selectorValue='@{viewModel.getLanguageName(viewModel.language)}' />

                <!-- Información adicional -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/info_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_fea_lightbulb"
                            app:tint="@color/secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/appearance_tip"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
