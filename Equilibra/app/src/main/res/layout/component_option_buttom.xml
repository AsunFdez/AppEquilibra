<?xml version="1.0" encoding="utf-8"?>
<!--
    Componente común: Botón de opción seleccionable
    Se usa para respuestas múltiples en cuestionarios
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Radio button o checkbox -->
        <View
            android:id="@+id/viewOptionIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/selector_option_indicator"
            android:layout_marginEnd="16dp" />

        <!-- Icono de la opción -->
        <ImageView
            android:id="@+id/ivOptionIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_uti_check"
            android:tint="@color/equilibra_secondary"
            android:layout_marginEnd="16dp"
            android:visibility="visible" />

        <!-- Texto de la opción -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título de opción"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvOptionDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción de la opción"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Indicador de selección -->
        <ImageView
            android:id="@+id/ivSelectedIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_uti_check"
            android:tint="@color/equilibra_primary"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
