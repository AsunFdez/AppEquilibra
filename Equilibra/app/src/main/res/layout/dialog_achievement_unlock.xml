<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: Achievement Unlock -->
<!-- Propósito: Mostrar el logro desbloqueado con estilo celebratorio -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="32dp">

    <!-- Fondo con borde decorativo -->
    <LinearLayout
        android:id="@+id/dialog_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_impact_warning"
        android:padding="24dp">

        <!-- Contenedor para Icono y Chispas (centrado arriba) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <!-- Elemento de chispas (detrás del icono) -->
            <ImageView
                android:id="@+id/sparkles"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_onb_sparkles"
                app:tint="@color/primary"/>

            <!-- Icono del logro -->
            <ImageView
                android:id="@+id/achievement_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="@color/primary"
                android:contentDescription="@string/achievement_icon" />

        </FrameLayout>

        <!-- Título: "¡Logro Desbloqueado!" -->
        <TextView
            android:id="@+id/achievement_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Primer Paso"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:layout_marginBottom="8dp" />

        <!-- Descripción del logro -->
        <TextView
            android:id="@+id/achievement_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Has completado tu primer registro de gasto"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <!-- Puntos ganados -->
        <TextView
            android:id="@+id/achievement_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+10 pts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <!-- Botón de acción: Genial -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_awesome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/awesome"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="24dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Botón de cierre (X) arriba a la derecha -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        app:tint="@color/gray_500"
        android:contentDescription="@string/close" />

</FrameLayout>
