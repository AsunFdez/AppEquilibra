<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: Achievement Unlock -->
<!-- Propósito: Mostrar el logro desbloqueado con estilo celebratorio -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="32dp">

    <!-- Fondo con borde decorativo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_impact_warning"
        android:padding="24dp">

        <!-- Icono del logro (grande y prominent) -->
        <ImageView
            android:id="@+id/achievement_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/achievement_icon" />

        <!-- Título: "¡Logro Desbloqueado!" -->
        <TextView
            android:id="@+id/achievement_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Primer Paso"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:layout_marginBottom="8dp" />

        <!-- Descripción del logro -->
        <TextView
            android:id="@+id/achievement_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Has completado tu primer registro de gasto"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <!-- Puntos ganados -->
        <TextView
            android:id="@+id/achievement_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+10 pts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:textAlignment="center" />

    </LinearLayout>

    <!-- Elemento de chispas (invisible por defecto, animado) -->
    <View
        android:id="@+id/sparkles"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:background="@drawable/ic_onb_sparkles" />

</FrameLayout>
