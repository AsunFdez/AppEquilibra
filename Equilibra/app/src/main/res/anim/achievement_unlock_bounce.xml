<?xml version="1.0" encoding="utf-8"?>
<!-- Animación: Achievement Unlock - Bounce Effect -->
<!-- Propósito: Efecto de salto cuando se desbloquea un logro -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="800">

    <!-- Fase 1: Comprimir (0-150ms) -->
    <scale
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:toXScale="0.8"
        android:toYScale="0.8"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="150"
        android:startOffset="0" />

    <!-- Fase 2: Expandir (150-400ms) -->
    <scale
        android:fromXScale="0.8"
        android:fromYScale="0.8"
        android:toXScale="1.15"
        android:toYScale="1.15"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="250"
        android:startOffset="150"
        android:interpolator="@android:interpolator/bounce" />

    <!-- Fase 3: Normalizar (400-800ms) -->
    <scale
        android:fromXScale="1.15"
        android:fromYScale="1.15"
        android:toXScale="1.0"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="400"
        android:startOffset="400"
        android:interpolator="@android:interpolator/decelerate_cubic" />

</set>
