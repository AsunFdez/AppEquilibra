# Root .gitignore for Android project

# Gradle
.gradle/
gradle/
gradle-wrapper.jar

# Build outputs
**/build/
*/build/

# IDEs
*.iml
.idea/
.vscode/

# Local config
/local.properties
/captures

# OS files
.DS_Store
Thumbs.db

# Logs and temp
*.log
*~
~$*

# Android artifacts
*.apk
*.ap_
*.aab
*.dex
*.class

# NDK/External build
.externalNativeBuild
.cxx

# Gradle wrapper executables 
gradlew
gradlew.bat

# Documentation / generated images (ignore exported files)
Documentación/
plantUML/*.png
